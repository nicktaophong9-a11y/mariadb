+#ifdef MARIADB_PREAUTH_FUZZ_HOOK
+/*
+  Discovery-only harness. This is NOT part of the server: it is behind a build
+  macro and an environment variable, and must never be in a build that is not
+  an instrumented one used for bug hunting.
+
+  Network fuzzing of the handshake is bounded by TCP connection setup, around
+  fifty cases a second. Measured coverage showed the reachable pre-auth code is
+  already almost fully traversed, so what is missing is not coverage but the
+  number of distinct inputs per covered branch. This re-runs
+  parse_client_handshake_packet() over mutated copies of the packet the client
+  actually sent, against the real THD, NET and ACL state, so one connection
+  yields thousands of parses.
+
+  Two capability bits are cleared from every mutated packet because their
+  branches perform network I/O from inside the loop and would block:
+  CLIENT_SSL calls sslaccept(), and CLIENT_PLUGIN_AUTH is what lets the parser
+  reach the auth-switch branch that calls my_net_read(). Both are exercised
+  over the network instead (see poc_coverage_gaps.py).
+
+  Anything that crashes here must be reproduced over the network against an
+  unmodified binary before it counts as a finding.
+*/
+
+static void preauth_fuzz_reparse(MPVIO_EXT *mpvio, ulong pkt_len)
+{
+  static int probed= 0;
+  static ulong iterations= 0;
+  if (!probed)
+  {
+    probed= 1;
+    const char *e= getenv("MARIADB_FUZZ_HANDSHAKE");
+    iterations= e ? strtoul(e, NULL, 10) : 0;
+  }
+  if (!iterations || pkt_len < MIN_HANDSHAKE_SIZE || pkt_len > 8192)
+    return;
+
+  THD *thd= mpvio->auth_info.thd;
+  NET *net= &thd->net;
+
+  uchar *orig= (uchar*) my_malloc(PSI_NOT_INSTRUMENTED, pkt_len + 1, MYF(0));
+  if (!orig)
+    return;
+  memcpy(orig, net->read_pos, pkt_len + 1);
+
+  const ulonglong saved_caps= thd->client_capabilities;
+  ACL_USER *const saved_acl_user= mpvio->acl_user;
+  const uint saved_curr_auth= mpvio->curr_auth;
+  ulong seed= (ulong) thd->thread_id * 2654435761UL + (ulong) pkt_len + 1;
+
+  for (ulong i= 0; i < iterations; i++)
+  {
+    ulong len= pkt_len;
+    preauth_unpoison_buffer(net);       /* our own memcpy must not trip it */
+    memcpy(net->read_pos, orig, pkt_len + 1);
+
+    uint nmut= 1 + (uint) (seed % 8);
+    for (uint m= 0; m < nmut; m++)
+    {
+      seed= seed * 1103515245UL + 12345UL;
+      ulong off= (seed >> 8) % pkt_len;
+      seed= seed * 1103515245UL + 12345UL;
+      net->read_pos[off]= (uchar) (seed >> 16);
+    }
+
+    /* sometimes shorten the packet, preserving the terminator that
+       my_net_read() guarantees at read_pos[len] */
+    seed= seed * 1103515245UL + 12345UL;
+    if ((seed >> 7) & 1)
+    {
+      len= MIN_HANDSHAKE_SIZE +
+           ((seed >> 9) % (pkt_len - MIN_HANDSHAKE_SIZE + 1));
+      net->read_pos[len]= 0;
+    }
+
+    net->read_pos[1]&= (uchar) ~((CLIENT_SSL >> 8) & 0xff);
+    net->read_pos[2]&= (uchar) ~((CLIENT_PLUGIN_AUTH >> 16) & 0xff);
+    /*
+      NOTES 4.3 -- the out-of-packet strlen() in the !CLIENT_SECURE_CONNECTION
+      branch -- is a known and recorded read, and under the tail poisoning it
+      halts the server on the first mutated packet that reaches it. Keeping the
+      bit set lets the poisoned run explore the rest of the parser instead of
+      stopping on something already written up. That branch is still exercised
+      over the network, where the poisoning is not in effect.
+    */
+    net->read_pos[1]|= (uchar) ((CLIENT_SECURE_CONNECTION >> 8) & 0xff);
+
+    thd->client_capabilities= saved_caps;
+    mpvio->acl_user= NULL;
+    mpvio->curr_auth= 0;
+    mpvio->status= MPVIO_EXT::FAILURE;
+    mpvio->cached_client_reply.pkt= 0;
+    mpvio->cached_client_reply.pkt_len= 0;
+    mpvio->cached_client_reply.plugin= ""_LEX_CSTRING;
+
+    uchar *sink= NULL;
+    preauth_poison_tail(net, len);      /* any read past the body now reports */
+    (void) parse_client_handshake_packet(mpvio, &sink, len);
+    thd->clear_error();
+  }
+
+  preauth_unpoison_buffer(net);
+  memcpy(net->read_pos, orig, pkt_len + 1);
+  my_free(orig);
+  thd->client_capabilities= saved_caps;
+  mpvio->acl_user= saved_acl_user;
+  mpvio->curr_auth= saved_curr_auth;
+  mpvio->status= MPVIO_EXT::FAILURE;
+  mpvio->cached_client_reply.pkt= 0;
+  mpvio->cached_client_reply.pkt_len= 0;
+  mpvio->cached_client_reply.plugin= ""_LEX_CSTRING;
+  thd->clear_error();
+}
+#endif /* MARIADB_PREAUTH_FUZZ_HOOK */
