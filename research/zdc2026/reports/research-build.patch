+/*
+  Research build only. MARIADB_PREAUTH_STOCK=1 turns off both the fixes applied
+  below and the tail poisoning, so the build behaves like the shipped binary
+  while still running under ASAN. That is what is needed to show whether a bug
+  is reachable in the real allocator's behaviour rather than in the
+  instrumentation's.
+*/
+static my_bool preauth_stock_mode(void)
+{
+  static int probed= 0, stock= 0;
+  if (!probed)
+  {
+    const char *e= getenv("MARIADB_PREAUTH_STOCK");
+    stock= e && *e && *e != '0';
+    probed= 1;
+  }
+  return (my_bool) stock;
+}
+
+/*
+  Research build only.
+
+  NOTES 4.2 and 4.3 are reads that leave the packet body but stay inside the
+  net->buff allocation, which is exactly why ASAN cannot see them: the slack
+  between the end of the packet and net->buff_end is addressable memory. For
+  the duration of each re-parse the slack is poisoned, so a read past the
+  packet is reported instead of landing silently in the same allocation.
+
+  This is only safe inside the hook, where the loop has cleared CLIENT_SSL and
+  CLIENT_PLUGIN_AUTH out of the packet: the parser therefore performs no
+  network I/O, so nothing legitimately writes into the poisoned slack. Poisoning
+  around the *network* parse would false-positive on the auth-switch branch,
+  which calls my_net_read() from inside parse_client_handshake_packet().
+*/
+#ifdef __SANITIZE_ADDRESS__
+#include <sanitizer/asan_interface.h>
+static inline void preauth_poison_tail(NET *net, ulong len)
+{
+  uchar *from= net->read_pos + len + 1;  /* +1: the terminator my_net_read sets */
+  /* ASAN poisons whole 8-byte granules; round up so nothing real is covered */
+  from= (uchar*) (((uintptr_t) from + 7) & ~(uintptr_t) 7);
+  if (net->buff_end > from)
+    __asan_poison_memory_region(from, (size_t) (net->buff_end - from));
+}
+static inline void preauth_unpoison_buffer(NET *net)
+{
+  if (net->buff && net->buff_end > net->buff)
+    __asan_unpoison_memory_region(net->buff,
+                                  (size_t) (net->buff_end - net->buff));
+}
+#else
+static inline void preauth_poison_tail(NET *, ulong) {}
+static inline void preauth_unpoison_buffer(NET *) {}
+#endif
+
+/*
+  Research build only. Scope guard so the *network* parse gets the same tail
+  poisoning the hook has, without sprinkling unpoison calls over the ~20 return
+  paths of parse_client_handshake_packet(): the destructor lifts it on every
+  exit. lift() is for the nested network I/O inside the parse, which writes into
+  net->buff legitimately (read and write share the buffer).
+*/
+class Preauth_tail_poison
+{
+  NET *m_net;
+public:
+  Preauth_tail_poison(NET *net, ulong len) : m_net(net)
+  { if (!preauth_stock_mode()) preauth_poison_tail(net, len); }
+  void lift() { preauth_unpoison_buffer(m_net); }
+  ~Preauth_tail_poison() { preauth_unpoison_buffer(m_net); }
+};
